# Test Environment Configuration
# Copy this file to .env.local for local development with test environment

# Node Environment
NODE_ENV=development
VERCEL_ENV=preview

# Google Cloud / BigQuery Configuration
GOOGLE_CLOUD_PROJECT_ID=immigrant-central-test
BIGQUERY_DATASET_ID=h1b_data_test
BIGQUERY_TABLE_ID=lca_applications

# BigQuery Credentials (paste contents of serviceAccountKey-test.json)
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"immigrant-central-test","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"bigquery-test-service@immigrant-central-test.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Firebase Test Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-test-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=immigrant-central-test.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=immigrant-central-test
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=immigrant-central-test.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-test-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-test-app-id

# Firebase Admin SDK (for server-side)
FIREBASE_PROJECT_ID=immigrant-central-test
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@immigrant-central-test.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Other Services
GOOGLE_GENAI_API_KEY=your-genai-api-key-here

# Optional: Custom test domain (if using subdomain)
NEXT_PUBLIC_APP_URL=https://immigrant-central-test.vercel.app