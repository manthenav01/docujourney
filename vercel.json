{
  "version": 2,
  "builds": [
    {
      "src": "apps/public-app/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/public-app/$1"
    }
  ],
  "installCommand": "npm install",
  "buildCommand": "npm run build:public",
  "outputDirectory": "apps/public-app/.next",
  "framework": "nextjs",
  "functions": {
    "apps/public-app/app/api/**/*.ts": {
      "maxDuration": 30
    }
  }
}