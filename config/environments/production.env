# Production Environment Configuration
# Uses dedicated production project (to be created)

# BigQuery Configuration
GOOGLE_CLOUD_PROJECT_ID=doctracker-prod
BIGQUERY_DATASET_ID=h1b_data
BIGQUERY_TABLE_ID=lca_applications

# Authentication (use individual environment variables)
GOOGLE_CLOUD_CLIENT_EMAIL=[PRODUCTION_SERVICE_ACCOUNT_EMAIL]
GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n[PRODUCTION_PRIVATE_KEY_CONTENT]\n-----END PRIVATE KEY-----"

# Logging Configuration
LOG_LEVEL=warn

# Note: Update these values when the production project is created